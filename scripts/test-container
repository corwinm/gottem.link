#!/bin/sh
set -eu

image="gottem-link-smoke:${GITHUB_SHA:-local}"
container=
cleanup() {
	if [ -n "$container" ]; then
		docker rm -f "$container" >/dev/null 2>&1 || true
	fi
	docker image rm "$image" >/dev/null 2>&1 || true
}
trap cleanup EXIT HUP INT TERM

docker build --build-arg GO_VERSION=1.27.0 -t "$image" .
container=$(docker run -d -p 127.0.0.1::8080 --entrypoint sh "$image" -c \
	'sqlite3 /tmp/gottem.db "CREATE TABLE redirects (id INTEGER PRIMARY KEY, slug TEXT, url TEXT);" && exec run-app -addr :8080 -dsn /tmp/gottem.db')
address=$(docker port "$container" 8080/tcp)

attempt=0
until body=$(curl --fail --silent --show-error --max-time 2 "http://$address/healthz"); do
	attempt=$((attempt + 1))
	if [ "$attempt" -ge 30 ]; then
		docker logs "$container" >&2
		exit 1
	fi
	sleep 1
done
test "$body" = "ok"

test "$(curl --fail --silent --show-error --max-time 2 "http://$address/readyz")" = "ok"
printf 'container smoke test passed\n'
